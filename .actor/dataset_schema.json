            "group_ids": {
                "type": [
                    "array",
                    "null"
                ]
            },
            "part_ids": {
                "type": [
                    "array",
                    "null"
                ]
            },
            "eligibility": {
                "type": [
                    "object",
                    "null"
                ],
                "description": "Raw TED selection/exclusion/reservation fields. No eligibility verdict or inferred requirements."
            },
            "sme_suitability": {
                "type": [
                    "object",
                    "null"
                ],
                "description": "Raw scoped TED indicators, including explicit false values. Not a company SME assessment."
            },
            "notice_type": {
                "type": [
                    "string",
                    "null"
