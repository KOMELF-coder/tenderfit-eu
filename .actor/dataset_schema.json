                        "maximum": 10
                    },
                    "currency": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5
                    },
                    "deadline": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 5
                    }
                }
            },
            "match_reasons": {
                "type": "array",
                "items": {
                    "type": "string"
                }
            },
            "warnings": {
                "type": "array",
                "items": {
                    "type": "string"
                }
