                    "type": "string"
                }
            },
            "days_until_deadline": {
                "type": [
                    "integer",
                    "null"
                ],
                "description": "Earliest published deadline calendar date minus UTC today; may be negative."
            },
            "estimated_value_scope": {
                "type": [
                    "string",
                    "null"
                ],
                "enum": [
                    "proc",
                    "lot",
                    "glo",
                    "part",
                    null
                ]
            },
            "scope_titles": {
                "type": [
                    "object",
                    "null"
                ]
            },
            "description": {
                "type": [
                    "object",
                    "null"
                ],
                "description": "Raw multilingual descriptions by proc/lot/glo/part scope."
            },
            "procedure_type": {
                "type": [
                    "string",
                    "null"
                ]
            },
            "procedure_id": {
                "type": [
                    "string",
                    "null"
                ]
